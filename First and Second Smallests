class Solution {
    public ArrayList<Integer> minAnd2ndMin(int[] arr) {
        // code here
       int firstmin=Integer.MAX_VALUE;
       int secondmin=Integer.MAX_VALUE;
       ArrayList<Integer> list=new ArrayList<>();
       for(int i:arr){
           if(firstmin>i){
               firstmin=i;
           }
       }
       for(int i:arr){
           if(firstmin<i && i<secondmin){
               secondmin=i;
           }
       }
      if(secondmin==Integer.MAX_VALUE){
          list.add(-1);
          return list;
      }
       list.add(firstmin);
       list.add(secondmin);
       return list;
    }
}

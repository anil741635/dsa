class GfG {
    public Stack<Integer> sort(Stack<Integer> s) {
        int arr[]=new int[s.size()];
        for(int i=0;i<arr.length;i++)
        {
            arr[i]=s.pop();
        }
        Arrays.sort(arr);
        for(int i=0;i<arr.length;i++)
        {
            s.push(arr[i]);
        }
         return s;
    }
}

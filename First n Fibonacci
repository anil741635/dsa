class Solution {
    // Function to return list containing first n fibonacci numbers.
    public static int[] fibonacciNumbers(int n) {
        // Your code here
        int a=0,b=1,sum=0;
        int arr[]=new int[n];
        for(int i=0;i<n;i++){
            arr[i]=a;
            sum=a+b;
            a=b;
            b=sum;
        }
        return arr;
    }
}

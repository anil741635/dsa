class Solution {
    public int countOccurence(int[] arr, int k) {
        // code here
        Map<Integer,Integer> map=new HashMap<>();
        for(int i:arr){
            map.put(i,map.getOrDefault(i,0)+1);
        }
        int count=0;
        for(int i:map.keySet()){
            if(map.get(i)>(arr.length/k)) count++;
        }
        return count;
    }
}

class Solution {
    ArrayList<Integer> bracketNumbers(String s) {
        // code here
        ArrayList<Integer> list=new ArrayList<>();
        Stack<Integer> st=new Stack<>();
        int count=0;
        for(int i=0;i<s.length();i++){
            if(s.charAt(i)=='('){
                count++;
                st.push(count);
                list.add(count);
            }
            else if(s.charAt(i)==')'){
               list.add(st.pop());
            }
        }
        return list;
    }
};

class Solution {
    int arraySum(int arr[]) {
        // code here
        int n=arr.length;
       return sum(arr,n);
    }
    public int sum(int arr[],int n){
        if(n==0){
            return 0;
        }
        return sum(arr,n-1)+arr[n-1];
    }
}





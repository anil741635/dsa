class Solution {
    public int longestConsecutive(int[] arr) {
        // code here
       Set<Integer> set=new HashSet<>();
        for(int i=0;i<arr.length;i++){
            set.add(arr[i]);
        }
        int maxlen=0;
       for(int i=0;i<arr.length;i++){
         if(!set.contains(arr[i]-1)){
             int start=arr[i];
             int len=1;
             while(set.contains(start+1)){
             start++;
             len++;
            }
         maxlen=Math.max(len,maxlen);
         }
       }
       return maxlen;
    }
}

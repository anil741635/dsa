class Solution {
    public int[] distributeCandies(int candies, int num_people) {
        int arr[]=new int[num_people];
        int i=1,pos=0;
       while(candies>0){
        arr[pos++]+=candies>=i?i:candies;
        candies-=i;
        i++;
        pos%=num_people;
       }
        return arr;
    }
}

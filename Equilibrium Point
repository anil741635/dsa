class Solution {
    public static int findEquilibrium(int arr[]) {
        // code here
        int totalsum=0;
        for(int i:arr){
            totalsum+=i;
        }
        int leftsum=0;
        for(int i=0;i<arr.length;i++){
            int rightsum=totalsum-leftsum-arr[i];
            if(leftsum==rightsum) return i;
            leftsum+=arr[i];
        }
        return -1;
    }
}

class Solution {
    public int findMinDiff(int arr[], int m) {
        // code here
        Arrays.sort(arr);
        int minlen=Integer.MAX_VALUE;
        for(int i=0;i<=arr.length-m;i++){
            int start=arr[i];
            int end=arr[i+m-1];
            int len=end-start;
            minlen=Math.min(minlen,len);
        }
        return minlen;
    }
}

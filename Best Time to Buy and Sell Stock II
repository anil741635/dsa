class Solution {
    public int maxProfit(int[] prices) {
        int dp[][]=new int[prices.length][2];
        for(int[] i:dp) Arrays.fill(i,-1);
        return helper(prices,0,1,dp);
    }
    public static int helper(int[] prices,int index,int buy,int[][] dp){
        if(index==prices.length) return 0;
        if(dp[index][buy]!=-1) return dp[index][buy];
        int profit=0;
        if(buy==1){
            int take=-prices[index]+helper(prices,index+1,0,dp);
            int notbuy=helper(prices,index+1,1,dp);
            profit= Math.max(take,notbuy);
        }
        else{
            int sell=prices[index]+helper(prices,index+1,1,dp);
            int notsell=helper(prices,index+1,0,dp);
            profit=Math.max(sell,notsell);
        }
        return dp[index][buy]=profit;
    }
}

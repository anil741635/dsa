class Solution {
    public static int[] productExceptSelf(int arr[]) {
        // code here
        int[] ans=new int[arr.length];
        int sum=1;
        int zero=0;
        for(int i:arr){
            if(i==0){
                zero++;
            } 
            else  sum*=i;
        } 
        if(zero>1) return ans;
        if(zero==1) {
            for(int i=0;i<arr.length;i++){
                if(arr[i]==0){
                    ans[i]=sum;
                }
                else ans[i]=0;
            }
        }
        else{
            int left=0;
           for(int i=0;i<arr.length;i++){
               int a=sum/arr[left];
               ans[left++]=a;
           }
        }
      return ans;
    }
}

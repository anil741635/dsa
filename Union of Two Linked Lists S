class Node {
    public int data;
    public Node next;

    public Node(int x) {
        data = x;
        next = null;
    }

}*/

class Solution {
    public Node makeUnion(Node head1, Node head2) {
        // code here
        Set<Integer> set=new HashSet<>();
        Node newhead=new Node(-1);
        Node nx=newhead;
        Node temp=head1;
        while(temp!=null){
            if(!set.contains(temp.data)){
                nx.next=new Node(temp.data);
                set.add(temp.data);
                nx=nx.next;
            }
            temp=temp.next;
        }
        temp=head2;
        while(temp!=null){
            if(!set.contains(temp.data)){
                nx.next=new Node(temp.data);
                set.add(temp.data);
                nx=nx.next;
            }
            temp=temp.next;
        }
        return newhead.next;
    }
}

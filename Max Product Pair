class Solution {
    public static int maxProduct(int[] arr) {
        // code here
        int firstmax=-1,secondmax=-1;
        for(int i=0;i<arr.length;i++){
            if(firstmax<arr[i]){
                secondmax=firstmax;
                firstmax=arr[i];
            }
            else if(secondmax<arr[i]) secondmax=arr[i];
        }
        return firstmax*secondmax;
    }
}

class Solution {
    public ArrayList<Integer> findRepeating(int[] arr) {
        // code here
        ArrayList<Integer> list=new ArrayList<>();
        Set<Integer> set=new HashSet<>();
        int value=-1;
        for(int i:arr){
            if(set.contains(i)){
                value=i;
                break;
            }
            else set.add(i);
        }
        list.add(value);
        if(value==-1){
            list.add(-1);
            return list;
        }
        int freq=0;
        for(int i=0;i<arr.length;i++){
            if(arr[i]==value) freq++;
        }
        list.add(freq);
        return list;
    }
}

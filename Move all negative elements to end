class Solution {
    public void segregateElements(int[] arr) {
        // Your code goes here
        int[] ans=new int[arr.length];
        int start=0;
        for(int i=0;i<arr.length;i++){
            if(arr[i]>=0) ans[start++]=arr[i];
        }
        for(int i=0;i<arr.length;i++){
            if(arr[i]<0) ans[start++]=arr[i];
        }
        for(int i=0;i<ans.length;i++){
            arr[i]=ans[i];
        }
    }
}

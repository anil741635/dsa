class Solution {
    public Node preToBST(int pre[]) {
        // code here
        return helper(pre,0,pre.length-1);
    }
    public static Node helper(int[] pre,int l,int r){
        if(l>r) return null;
        Node root=new Node(pre[l]);
        int i=l+1;
        while(i<=r && pre[i]<pre[l]){
            i++;
        }
        root.left=helper(pre,l+1,i-1);
        root.right=helper(pre,i,r);
        return root;
    }
}

class Solution {
    ArrayList<Integer> findMissing(int[] a, int[] b) {
        // code here
        Set<Integer> set=new HashSet<>();
        for(int i:b){
            set.add(i);
        }
        ArrayList<Integer> list=new ArrayList<>();
        for(int i:a){
            if(!set.contains(i)){
                list.add(i);
            }
        }
        return list;
    }
}

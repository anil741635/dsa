class Solution {
    public static boolean isPalinArray(int[] arr) {
        // code here.
        for(int i=0;i<arr.length;i++){
            if(!palindrome(arr[i])) return false;
        }
        return true;
    }
    public static boolean palindrome(int n){
        int temp=n;
        int rev=0;
        while(n>0){
             rev=rev*10+n%10;
             n/=10;
        }
        if(temp==rev) return true;
        return false;
    }
}

class Solution {
    int[] getMoreAndLess(int[] arr, int target) {
        // code here
        int lessthan=0,greaterthan=0;
        for(int i=0;i<arr.length;i++){
            if(arr[i]<target) lessthan++;
            else if(arr[i]>target) greaterthan++;
            else if(arr[i]==target){
                lessthan++;
                greaterthan++;
            }
        }
    return new int[] {lessthan,greaterthan};
    }
}

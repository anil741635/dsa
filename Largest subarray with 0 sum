class Solution {
    int maxLength(int arr[]) {
        // code here
        int len=0;
        Map<Integer,Integer> map=new HashMap<>();
        int sum=0;
        map.put(0,-1);
        for(int i=0;i<arr.length;i++){
            sum+=arr[i];
            if(sum==0) len=Math.max(len,i+1);
            else if(map.containsKey(sum)){
                len=Math.max(len,i-map.get(sum));
            }
            else map.put(sum,i);
        }
        return len;
    }
}

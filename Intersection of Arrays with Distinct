class Solution {
    public static int intersectSize(int a[], int b[]) {
        // Your code here
        Set<Integer> set=new HashSet<>();
        for(int i:a) set.add(i);
        int count=0;
        for(int i=0;i<b.length;i++){
            if(set.contains(b[i])) count++;
        }
        return count;
    }
}

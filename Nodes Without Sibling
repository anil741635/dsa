*/

class Solution {
    public List<Integer> noSibling(Node root) {
        // code here
        List<Integer> list=new ArrayList<>();
        Queue<Node> q=new LinkedList<>();
        q.add(root);
        helper(root,q,list);
        Collections.sort(list);
        return list;
    }
    public static void helper(Node root,Queue<Node> q,List<Integer> list){
        while(!q.isEmpty()){
            Node node=q.poll();
            if(node.left!=null && node.right==null) list.add(node.left.data);
            if(node.left==null && node.right!=null) list.add(node.right.data);
            if(node.left!=null) q.add(node.left);
            if(node.right!=null) q.add(node.right);
        }
        if(list.size()==0) list.add(-1);
    }
}

class Solution {
    public int orangesRot(int[][] mat) {
        // code here
        int fresh=0;
        int row=mat.length;
        int col=mat[0].length;
        Queue<int[]> q=new LinkedList<>();
        for(int i=0;i<row;i++){
            for(int j=0;j<col;j++){
                if(mat[i][j]==1) fresh++;
                else if (mat[i][j]==2) q.offer(new int[] {i,j});
            }
        }
        int days=0;
        int[][] dir={{1,0},{-1,0},{0,1},{0,-1}};
        while(!q.isEmpty() && fresh>0){
            int size=q.size();
            for(int i=0;i<size;i++){
                int[] curr=q.poll();
                for(int[] d:dir){
                    int r=curr[0]+d[0];
                    int c=curr[1]+d[1];
                    if(r>=0 && c>=0 && r<row && c<col  &&  mat[r][c]==1){
                        mat[r][c]=2;
                        fresh--;
                        q.offer(new int[] {r,c});
                    }
                }
            }
            days++;
        }
        return fresh==0? days:-1;
    }
}

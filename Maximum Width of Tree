class Solution {
    int maxWidth(Node root) {
        //  code here
        if(root==null) return 0;
        Queue<Node> q=new LinkedList<>();
        q.add(root);
        int maxi=q.size();
        while(!q.isEmpty()){
            int size=q.size();
            maxi=Math.max(size,maxi);
            for(int i=0;i<size;i++){
                Node node=q.poll();
                if(node.left!=null) q.add(node.left);
                if(node.right!=null) q.add(node.right);
            }
        }
        return maxi;
    }
}

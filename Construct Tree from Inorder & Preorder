/* Structure of a Tree Node
class Node {
    int data;
    Node left, right;

    Node(int val) {
        data = val;
        left = right = null;
    }
} */

class Solution {
    public static Node buildTree(int inorder[], int preorder[]) {
        // code here
        if(inorder.length!=preorder.length) return null;
        Map<Integer,Integer> map=new HashMap<>();
        for(int i=0;i<inorder.length;i++){
            map.put(inorder[i],i);
        }
        return helper(inorder,0,inorder.length-1,preorder,0,preorder.length-1,map);
    }
    public static Node helper(int[] inorder,int is,int ie,int[] preorder,int ps,int pe,Map<Integer,Integer> map){
        if(is>ie || ps>pe) return null;
        int rootvalue=preorder[ps];
        int index=map.get(rootvalue);
        int left=index-is;
        Node root=new Node(rootvalue);
        root.left=helper(inorder,is,index-1,preorder,ps+1,ps+left,map);
        root.right=helper(inorder,index+1,ie,preorder,ps+left+1,pe,map);
        return root;
    }
}

class Solution {
    String firstRepChar(String s) {
        // code here
        s=s.toLowerCase();
        char ch[]=new char[26];
        for(int i=0;i<s.length();i++){
            ch[s.charAt(i)-'a']++;
            if(ch[s.charAt(i)-'a']>1) return String.valueOf(s.charAt(i));
        }
        return "-1";
    }
}

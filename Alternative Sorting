class Solution {
    public static ArrayList<Integer> alternateSort(int[] arr) {
        // code here
        Arrays.sort(arr);
        ArrayList<Integer> list=new ArrayList<>();
        int mid=arr.length/2;
        int a1[]=new int[mid];
        for(int i=0;i<a1.length;i++){
            a1[i]=arr[i];
        }
        int j=0;
        for(int i=arr.length-1;i>=mid;i--){
            list.add(arr[i]);
            if(j<a1.length)
               list.add(a1[j++]);
        }
        return list;
    }
}

/*
Definition for Node
class Node {
    int data;
    Node left, right;

    Node(int val) {
        data = val;
        left = right = null;
    }
}
*/

class Solution {
    public Node insert(Node root, int key) {
        // code here
        if(root==null) return new Node(key);
        Node curr=root;
        while(curr!=null){
            if(curr.data<=key){
                if(curr.right==null) {
                    curr.right=new Node(key);
                    break;
                }
                else{
                    curr=curr.right;
                }
            }
            else{
                if(curr.left==null){
                    curr.left=new Node(key);
                    break;
                }
                else{
                    curr=curr.left;
                }
            }
        }
        return root;
    }
}

class Solution {
    public int convertFive(int n) {
        // code here
        String str=String.valueOf(n);
        char[] s=str.toCharArray();
        for(int i=0;i<s.length;i++){
            if(s[i]=='0'){
               s[i]='5';
            }
        }
        return Integer.parseInt(new String(s));
    }
}

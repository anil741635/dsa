class Solution {
    public static ArrayList<Integer> countLessEq(int a[], int b[]) {
        // code here
        ArrayList<Integer> list=new ArrayList<>();
        Arrays.sort(b);
        for(int i=0;i<a.length;i++){
            int value=a[i];
            int count=check(value,b);
            list.add(count);
        }
        return list;
    }
    public static int check(int value,int[] b){
        int left=0,right=b.length-1;
        int ans=0;
        while(left<=right){
            int mid=left+(right-left)/2;
            if(b[mid]<=value){
                ans=mid+1;
                left=mid+1;
            }
            else right=mid-1;
        }
        return ans;
    }
}

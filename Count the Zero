class Solution {
    int countZeroes(int[] arr) {
        // code here
        int firstZero=arr.length;
        int left=0,right=arr.length-1;
        while(left<=right){
            int mid=left+(right-left)/2;
            if(arr[mid]==0){ 
                 firstZero=mid;
                 right=mid-1;
            }
            else left=mid+1;
        }
        return arr.length-firstZero;
    }
}

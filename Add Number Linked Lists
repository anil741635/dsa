import java.math.BigInteger;
class Solution {
    public Node addTwoLists(Node head1, Node head2) {
        // code here
        StringBuilder sb=new StringBuilder();
        while(head1!=null){
            if(sb.length()==0){
                if(head1.data==0){
                    head1=head1.next;
                    continue;
                } 
            }
            sb.append(head1.data);
            head1=head1.next;
        }
        StringBuilder sb1=new StringBuilder();
        while(head2!=null){
            if(sb1.length()==0){
                if(head2.data==0) {
                    head2=head2.next;
                    continue;
                }
            }
            sb1.append(head2.data);
            head2=head2.next;
        }
        String str1=sb.length()==0?"0":sb.toString();
        String str2=sb1.length()==0?"0":sb1.toString();
        BigInteger num1=new BigInteger(str1);
        BigInteger num2=new BigInteger(str2);
        String s=num1.add(num2).toString();
        Node newhead=new Node(s.charAt(0)-'0');
        Node temp=newhead;
        for(int i=1;i<s.length();i++){
            temp.next=new Node(s.charAt(i)-'0');
            temp=temp.next;
        }
        return newhead;
    }
}

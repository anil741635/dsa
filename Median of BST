*/

class Solution {
    public int findMedian(Node root) {
        // Code here
        List<Integer> list=new ArrayList<>();
        inorder(root,list);
        int mid=(list.size()-1)/2;
        return list.get(mid);
    }
    public static void inorder(Node root,List<Integer> list){
        if(root==null) return;
        inorder(root.left,list);
        list.add(root.data);
        inorder(root.right,list);
    }
}

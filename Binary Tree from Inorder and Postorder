/* Structure of binary tree node
class Node {
    int data;
    Node left, right;
    Node(int x) {
        data = x;
        left = right = null;
    }
} */

class Solution {
    public Node buildTree(int[] inorder, int[] postorder) {
        // code here
        if(inorder.length!=postorder.length) return null;
        Map<Integer,Integer> map=new HashMap<>();
        for(int i=0;i<inorder.length;i++){
            map.put(inorder[i],i);
        }
        return helper(inorder,0,inorder.length-1,postorder,0,postorder.length-1,map);
    }
    public static Node helper(int[] inorder,int is,int ie,int[] postorder,int ps,int pe,Map<Integer,Integer> map){
        if(is>ie || ps>pe) return  null;
        int rootvalue=postorder[pe];
        int index=map.get(rootvalue);
        int left=index-is;
        Node root=new Node(rootvalue);
        root.left=helper(inorder,is,index-1,postorder,ps,ps+left-1,map);
        root.right=helper(inorder,index+1,ie,postorder,ps+left,pe-1,map);
        return root;
    }
}

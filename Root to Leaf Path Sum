class Solution {
	boolean hasPathSum(Node root, int target) {
		// code here
		if(root==null) return false;
		return helper(root,target,0);
	}
	public static boolean helper(Node root,int target,int sum){
	    if(root==null) return false;
	    sum+=root.data;
	    if(root.left==null && root.right==null && target==sum) return true;
	    return helper(root.left,target,sum) || helper(root.right,target,sum);
	}
}

class Solution {
    public ArrayList<Integer> pattern(int n) {
        // code here
        ArrayList<Integer> list=new ArrayList<>();
        if(n<=0){
            list.add(n);
            return list;
        } 
         helper(list,n,n,true);
         return list;
    }
    public static void helper(ArrayList<Integer> list,int n,int original,boolean decrease){
       list.add(n);
       if(n>0 && decrease){
           helper(list,n-5,original,true);
       }
       else if(n<original){
           helper(list,n+5,original,false);
       }
    }
}

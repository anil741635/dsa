class Solution {
    boolean sameFreq(String s) {
        // code here
       int[] freq=new int[26];
       for(int i=0;i<s.length();i++){
           freq[s.charAt(i)-'a']++;
       }
       if(check(freq)) return true;
       for(int i=0;i<26;i++){
           if(freq[i]==0) continue;
           freq[i]--;
           if(check(freq)) return true;
           freq[i]++;
       }
       return false;
    }
    public static boolean check(int[] freq){
        int common=0;
        for(int f:freq){
            if(f!=0 && common==0) common=f;
            else if(f!=0 && common!=0 && f!=common) return false;
        }
        return true;
    }
}
